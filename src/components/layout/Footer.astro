---
import { site } from '../../lib/site';
---

<footer class="border-t border-forest-900/10 bg-white">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-forest-900/70 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-semibold text-forest-900">{site.brand}</p>
      <p>Ланч-боксы для outdoor-туров • {site.location}</p>
    </div>
    <a
      href={site.contact.telegram}
      class="font-medium text-forest-700 hover:underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Telegram {site.contact.telegramHandle}
    </a>
  </div>
</footer>

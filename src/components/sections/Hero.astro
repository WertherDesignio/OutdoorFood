---
import { site } from '../../lib/site';
---

<section class="relative overflow-hidden bg-gradient-to-br from-forest-700 via-forest-600 to-earth-700 text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 md:grid-cols-[1.2fr_0.8fr] md:items-center">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-white/70">Партнёрская модель • {site.location}</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl">{site.title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-white/85">{site.tagline}</p>
      <p class="mt-3 max-w-2xl text-white/70">{site.audience}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#pilot" class="btn-primary bg-white text-forest-800 hover:bg-forest-50">
          Запустить пилот 50–100 боксов
        </a>
        <a href="#products" class="btn-secondary border-white/30 bg-transparent text-white hover:bg-white/10">
          Посмотреть линейку
        </a>
      </div>
    </div>

    <div class="card border-white/20 bg-white/10 text-white backdrop-blur">
      <p class="text-sm uppercase tracking-wide text-white/70">Компактный формат</p>
      <h2 class="mt-3 text-2xl font-semibold">3 секции — один готовый набор</h2>
      <ul class="mt-6 space-y-3 text-white/85">
        <li>• сухофрукты — быстрый источник энергии</li>
        <li>• морковь / свежий овощ — свежесть и баланс</li>
        <li>• печенье — понятный десерт и удовольствие</li>
        <li>• прозрачный контейнер — продукт видно сразу</li>
        <li>• удобно взять в автобус, джип или рюкзак</li>
      </ul>
    </div>
  </div>
</section>

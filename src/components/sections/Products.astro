---
import { products, formatPrice, assetUrl } from '../../lib/products';
---

<section id="products" class="bg-earth-100">
  <div class="mx-auto max-w-6xl px-4 py-20">
    <h2 class="section-title">Линейка ланч-боксов</h2>
    <p class="section-lead">Три варианта под разный вкус, бюджет и формат outdoor-тура.</p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        products.map((product) => (
          <article class="card flex flex-col overflow-hidden p-0">
            <img
              src={assetUrl(product.image)}
              alt={`${product.name}: ${product.composition.join(', ')}`}
              class="aspect-[4/5] w-full object-cover"
              loading="lazy"
            />
            <div class="flex flex-1 flex-col p-6">
              <p class="text-sm font-semibold uppercase tracking-wide text-earth-700">{product.name}</p>
              <h3 class="mt-2 text-xl font-semibold text-forest-900">{product.description}</h3>
              <p class="mt-4 text-sm text-forest-900/70">
                {product.composition.join(' + ')}
              </p>
              <p class="mt-6 text-lg font-semibold text-forest-900">
                {formatPrice(product.partnerPrice, product.currency)} для партнёра
              </p>
              <a href="#pilot" class="btn-secondary mt-auto pt-8">
                Запросить состав
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

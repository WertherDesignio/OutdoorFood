---
import { site } from '../../lib/site';
---

<section id="benefits" class="mx-auto max-w-6xl px-4 py-20">
  <h2 class="section-title">Почему это нужно туристическому бизнесу</h2>
  <p class="section-lead">
    В outdoor-туре еда — это не просто расход. Это часть впечатления гостя. Рынок уже продаёт туры с
    включённым обедом / пикником: это привычный элемент outdoor-продукта.
  </p>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {
      site.benefits.map((item) => (
        <article class="card">
          <h3 class="text-xl font-semibold text-forest-900">{item.title}</h3>
          <p class="mt-3 text-forest-900/75">{item.text}</p>
        </article>
      ))
    }
  </div>
</section>

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-20">
    <h2 class="section-title">Почему партнёру это выгодно</h2>
    <p class="section-lead">Не просто «еда», а дополнительный продукт внутри существующего тура.</p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        site.partnerValue.map((item) => (
          <article class="card bg-forest-50">
            <h3 class="text-xl font-semibold text-forest-900">{item.title}</h3>
            <p class="mt-3 text-forest-900/75">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

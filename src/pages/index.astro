---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Benefits from '../components/sections/Benefits.astro';
import Products from '../components/sections/Products.astro';
import Pricing from '../components/sections/Pricing.astro';
import Process from '../components/sections/Process.astro';
import Pilot from '../components/sections/Pilot.astro';
import { site } from '../lib/site';
import '../styles/global.css';
---

<BaseLayout title={`${site.brand} — ${site.title}`} description={site.tagline}>
  <Header />
  <main>
    <Hero />
    <Benefits />
    <Products />
    <Pricing />
    <Process />
    <Pilot />
  </main>
  <Footer />
</BaseLayout>
